rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.admin == true;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function groupVisibility(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.visibility;
    }

    function canReadGroup(groupId) {
      let v = groupVisibility(groupId);
      return v == "public"
        || (v == "members" && isGroupMember(groupId))
        || (v == "private" && isGroupMember(groupId))
        || isAdmin();
    }

    function canWriteGroup(groupId) {
      return isGroupMember(groupId) || isAdmin();
    }

    function isChatMember(chatId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId)/members/$(request.auth.uid));
    }

    // Check if requester follows the target user
    function isFollowing(targetUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(targetUid)/followers/$(request.auth.uid));
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin(); // Public profile fields should be separate or handled via function
      // For MVP, if we read users directly, we might expose too much.
      // Ideally, public profile is a subset.
      // Assuming client only reads what's needed or we trust MVP scope.
      // Reverting to more open read for profile discovery?
      // Let's allow read if signed in for MVP discovery, but real app needs "public_profile" doc.
      allow read: if isSignedIn();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid) || isAdmin();
      allow delete: if false;
    }

    // Followers subcollection
    match /users/{uid}/followers/{followerId} {
      allow read: if isSignedIn();
      // Only the follower can create/delete their own follow record
      allow create, delete: if isSelf(followerId);
    }

    // Following subcollection (denormalized for ease of access)
    match /users/{uid}/following/{targetUid} {
      allow read: if isSignedIn();
      allow create, delete: if isSelf(uid);
    }

    // Blocked subcollection
    match /users/{uid}/blocked/{targetUid} {
      allow read: if isSelf(uid);
      allow create, delete: if isSelf(uid);
    }

    // Albums
    match /users/{uid}/albums/{albumId} {
      function canReadAlbum() {
        return isSelf(uid)
          || (resource.data.visibility == "public")
          || (resource.data.visibility == "friends" && isFollowing(uid));
      }

      allow read: if canReadAlbum();
      allow create, update, delete: if isSelf(uid);

      // Photos subcollection (inherits visibility logic, but resource.data refers to photo)
      // So we need to check the parent album's visibility.
      // get() costs money, but essential here.
      match /photos/{photoId} {
        allow read: if isSelf(uid)
          || (
            get(/databases/$(database)/documents/users/$(uid)/albums/$(albumId)).data.visibility == "public"
          )
          || (
            get(/databases/$(database)/documents/users/$(uid)/albums/$(albumId)).data.visibility == "friends"
            && isFollowing(uid)
          );

        allow create, update, delete: if isSelf(uid);
      }
    }

    // ---------- groups ----------
    match /groups/{groupId} {
      allow read: if canReadGroup(groupId);

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.visibility in ["public","members","private"];

      allow update: if canWriteGroup(groupId);

      allow delete: if isAdmin();
    }

    match /groups/{groupId}/members/{uid} {
      allow read: if canReadGroup(groupId);

      allow create: if isSelf(uid)
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && groupVisibility(groupId) in ["public","members"];

      allow delete: if isSelf(uid) || isAdmin();

      allow update: if isAdmin();
    }

    // ---------- posts ----------
    match /posts/{postId} {
      allow read: if (isSignedIn() && (
        resource.data.visibility == "public"
        || (resource.data.groupId is string && canReadGroup(resource.data.groupId))
      )) || isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.visibility in ["public","members","private"]
        && (
          !(request.resource.data.groupId is string)
          || isGroupMember(request.resource.data.groupId)
        );

      allow update, delete: if (isSignedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    // ---------- comments ----------
    match /posts/{postId}/comments/{commentId} {
      function canReadPost() {
        return (exists(/databases/$(database)/documents/posts/$(postId)) &&
          (
            get(/databases/$(database)/documents/posts/$(postId)).data.visibility == "public"
            || (
              get(/databases/$(database)/documents/posts/$(postId)).data.groupId is string
              && canReadGroup(get(/databases/$(database)/documents/posts/$(postId)).data.groupId)
            )
          )
        ) || isAdmin();
      }

      allow read: if isSignedIn() && canReadPost();

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && canReadPost();

      allow update, delete: if (isSignedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    match /posts/{postId}/reactions/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSelf(uid);
    }

    // ---------- chats ----------
    match /chats/{chatId} {
      allow read: if isChatMember(chatId) || isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.type in ["dm","group"];

      allow update: if isChatMember(chatId) || isAdmin();

      allow delete: if isAdmin();
    }

    match /chats/{chatId}/members/{uid} {
      allow read: if isChatMember(chatId) || isAdmin();

      allow create: if isSelf(uid);

      allow delete: if isSelf(uid) || isAdmin();

      allow update: if isAdmin();
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isChatMember(chatId) || isAdmin();

      allow create: if isChatMember(chatId)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 8000;

      allow update, delete: if false;
    }

    // ---------- events ----------
    match /events/{eventId} {
      allow read: if isSignedIn() || isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.organizerId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.organizerId == request.auth.uid
        && request.resource.data.organizerId == request.auth.uid;

      allow delete: if isSignedIn() && resource.data.organizerId == request.auth.uid || isAdmin();
    }

    match /events/{eventId}/rsvps/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSelf(uid);
    }

    // ---------- verification requests ----------
    match /verificationRequests/{reqId} {
      // User can create, but only admin can read all/update status
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if isAdmin();
    }

    // ---------- reports ----------
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if isAdmin(); // only admins see reports
    }
  }
}
