rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function isValidSize() {
      return request.resource.size < 5 * 1024 * 1024; // 5MB
    }

    // User Profiles
    match /users/{uid}/public/{allPaths=**} {
      allow read: if true;
      allow write: if isSelf(uid) && isImage() && isValidSize();
    }

    // Album Images
    match /users/{uid}/albums/public/{allPaths=**} {
      allow read: if true;
      allow write: if isSelf(uid) && isImage() && isValidSize();
    }

    match /users/{uid}/albums/{visibility}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSelf(uid) && isImage() && isValidSize();
    }

    // Post Images
    match /posts/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isSelf(uid) && isImage() && isValidSize();
    }

    // Event Images
    match /events/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isSelf(uid) && isImage() && isValidSize();
    }

    // Verification Images (Write only by user, Read only by Admin - simulated by obscurity path in MVP or stricter logic)
    // Actually, storage rules don't easily support "isAdmin" from Firestore.
    // We will allow user to read/write their own verification folder. Admin can read everything if we use Admin SDK in backend,
    // but client-side admin panel needs read access.
    // For MVP: allow authenticated read if they know the path.
    match /verification/{uid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSelf(uid) && isImage() && isValidSize();
    }

    // Fallback: Deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
