rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function isValidSize() {
      return request.resource.size < 5 * 1024 * 1024; // 5MB
    }

    // User Profiles
    match /users/{uid}/public/{allPaths=**} {
      allow read: if true;
      allow write: if isSelf(uid) && isImage() && isValidSize();
    }

    // Album Images
    // Logic: storage rules cannot easily check firestore state (e.g. "isFollowing").
    // So we rely on:
    // 1. Obfuscated paths (UUIDs)
    // 2. Client obtaining the URL from Firestore (where access IS controlled).
    // But for "public" albums, we can allow open read.

    // Public Albums
    match /users/{uid}/albums/public/{allPaths=**} {
      allow read: if true;
      allow write: if isSelf(uid) && isImage() && isValidSize();
    }

    // Friends/Private Albums
    // Read: Restricted to owner.
    // Wait, if friends need to see it, they need read access.
    // Since we can't check friendship here easily without firebase.storage.rules extensions (which are complex),
    // we often use Signed URLs or allow authenticated read if the path is known (security by obscurity + auth).
    // Better approach for MVP: Allow read if authenticated. Access to the *listing* of images is controlled by Firestore.
    // If a user knows the exact filename of a private image, they can see it if logged in. This is a common MVP trade-off.
    match /users/{uid}/albums/{visibility}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSelf(uid) && isImage() && isValidSize();
    }

    // Post Images
    match /posts/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isSelf(uid) && isImage() && isValidSize();
    }

    // Event Images
    match /events/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isSelf(uid) && isImage() && isValidSize();
    }

    // Fallback: Deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
